resource "aws_ssm_association" "user_aws_config" {\n  for_each = local.users\n\n  name             = "AWS-RunShellScript"\n  association_name = "claude-user-aws-${each.key}"\n  apply_only_at_cron_interval = false\n\n  targets {\n    key    = "InstanceIds"\n    values = [var.instance_id]\n  }\n\n  parameters = {\n    commands = join("\n", each.value.enabled ? [\n      "set -euo pipefail",\n      "USERNAME='${each.key}'",\n      "UID_EXPECTED='${each.value.uid}'",\n      "GID_EXPECTED='${each.value.gid}'",\n      "HOME_PATH='${var.home_root}/${each.key}'",\n      "usermod -s /bin/bash \"$USERNAME\"",\n      "install -d -m 0700 -o \"$UID_EXPECTED\" -g \"$GID_EXPECTED\" \"$HOME_PATH/.aws\"",\n      "printf '[default]\\nregion = ${var.aws_region}\\ncredential_process = /usr/local/bin/claude-credential-process\\n' > \"$HOME_PATH/.aws/config\"",\n      "chown \"$UID_EXPECTED:$GID_EXPECTED\" \"$HOME_PATH/.aws/config\"",\n      "chmod 0600 \"$HOME_PATH/.aws/config\""\n    ] : [\n      "true"\n    ])\n  }\n\n  depends_on = [\n    aws_ssm_association.user_runtime,\n    aws_ssm_association.credential_broker\n  ]\n}\n