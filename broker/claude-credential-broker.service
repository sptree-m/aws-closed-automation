[Unit]
Description=Claude per-user AWS credential broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=BROKER_SOCKET=/run/claude-credential-broker.sock
Environment=BROKER_MAP=/etc/claude-credential-broker/users.json
Environment=BROKER_DURATION=3600
ExecStart=/usr/local/lib/claude-credential-broker/credential_broker.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/claude-credential-broker
RuntimeDirectory=claude-credential-broker
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
